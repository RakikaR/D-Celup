# Salin file ini menjadi ".env" lalu isi dengan kredensial project Supabase
# Anda (Project Settings → API di dashboard Supabase).
#
# JANGAN commit file ".env" ke git — sudah masuk .gitignore secara default.

# ── Server-side saja (JANGAN pakai prefix VITE_) ────────────────────────────
# Dipakai oleh src/lib/db/supabase.server.ts & src/lib/config.server.ts.
# Nilai-nilai ini tidak pernah dikirim ke browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# service_role key: akses penuh ke database, lewati semua RLS.
# Rahasiakan! Hanya boleh dipakai di server (lihat supabase.server.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Public / client-side (prefix VITE_ wajib) ───────────────────────────────
# Dipakai oleh src/hooks/use-auth.tsx (Supabase client di browser).
# Aman untuk diekspos ke client karena hanya pakai anon key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
